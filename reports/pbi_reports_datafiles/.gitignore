# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Python build/artifacts ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dll
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# --- Virtualenvs ---
.venv/
venv/
env/
ENV/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.ipynb_checkpoints/

# --- Editors/IDEs ---
.vscode/
.idea/
*.code-workspace

# --- Environment & secrets ---
*.env
*.env.*
.envrc
*.vault
*.pem
*.key

# --- Coverage / reports ---
.coverage
coverage.xml
htmlcov/

# --- Data & outputs (adjust paths as needed) ---
outputs/
data/
*.sqlite
*.db
*.parquet
*.feather
*.h5
*.zip
*.gz
*.bz2

# --- Logs (generic) ---
*.log
logs/
**/logs/

# --- Airflow: ignore runtime logs/state ---
reports/pbi_reports_datafiles/monitoring_data_collection_tool/deployment/monitoring_data_collection_tool_airflow/logs/
reports/pbi_reports_datafiles/monitoring_data_collection_tool/deployment/monitoring_data_collection_tool_airflow/airflow.db
reports/pbi_reports_datafiles/monitoring_data_collection_tool/deployment/monitoring_data_collection_tool_airflow/airflow.sqlite
reports/pbi_reports_datafiles/monitoring_data_collection_tool/deployment/monitoring_data_collection_tool_airflow/*.pid

# If you keep Docker volumes/state under the project, ignore them:
docker-data/
tmp/
temp/

# --- Node (if any front-end bits) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Power BI autogenerated caches (safe to ignore) ---
*.pbix.tmp
*.pbit.tmp

# --- Jupyter Notebook checkpoints already covered, but also temp files ---
*.ipynb_checkpoints
.~*

# --- Windows line-ending noise backups ---
*.orig
